# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value below has a working default.
# ---------------------------------------------------------------------------

# Default: zero-setup SQLite file in the repo root.
# DATABASE_URL=sqlite+pysqlite:///./support.db
# Postgres (matches docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# Optional: keep LangGraph checkpoints in a separate database/schema.
# CHECKPOINT_DATABASE_URL=

# Leave unset to run the deterministic offline reasoner (no network, no cost).
# ANTHROPIC_API_KEY=sk-ant-...
MODEL_NAME=claude-sonnet-5-5
MODEL_TEMPERATURE=0.0
FORCE_OFFLINE_REASONER=false

CURRENCY=INR
RETURN_WINDOW_DAYS=30
APPROVAL_TTL_MINUTES=60
