# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value below has a working default.
# ---------------------------------------------------------------------------

# Default: zero-setup SQLite file in the repo root.
# DATABASE_URL=sqlite+pysqlite:///./support.db
# Postgres (matches docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# Optional: keep LangGraph checkpoints in a separate database/schema.
# CHECKPOINT_DATABASE_URL=

# Leave unset to run the deterministic offline reasoner (no network, no cost).
# ANTHROPIC_API_KEY=sk-ant-...
MODEL_NAME=claude-sonnet-5-5
MODEL_TEMPERATURE=0.0
FORCE_OFFLINE_REASONER=false

CURRENCY=INR
RETURN_WINDOW_DAYS=30
APPROVAL_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Free alternatives to Anthropic. Any OpenAI-compatible endpoint works.
# Set ONE of these blocks, then restart the server.
# ---------------------------------------------------------------------------

# Groq - free, no credit card, very fast. Key from console.groq.com
# LLM_PROVIDER=openai
# OPENAI_API_KEY=gsk_your_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile

# Ollama - runs on your own machine, no key, no network.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.1

# OpenRouter - one key, many models, has a free tier.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-or-your_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
